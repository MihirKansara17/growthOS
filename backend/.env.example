# GrowthOS V2 Environment Variables
# Copy this file to .env and replace the placeholders with your actual keys.
# DO NOT commit the actual .env file to Git!

# ----------------------------------------------------------------------
# 1. AI / LLM Configuration (OpenRouter)
# ----------------------------------------------------------------------
# Get your free API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY="sk-or-v1-YOUR_KEY_HERE"

# You can change the model to any free model on OpenRouter:
# e.g., meta-llama/llama-3.3-70b-instruct:free, google/gemini-2.0-flash-lite-preview-02-05:free
OPENROUTER_MODEL="meta-llama/llama-3.3-70b-instruct:free"

# ----------------------------------------------------------------------
# 2. Database Configuration (Supabase PostgreSQL)
# ----------------------------------------------------------------------
# For local testing, you can leave this commented out to use the local SQLite fallback.
# For production (Render), uncomment and set your Supabase URI.
# Get your connection string from: https://supabase.com/dashboard -> Project Settings -> Database
# Example: postgresql://postgres.abcdefg:YourPassword123@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
# DATABASE_URL="postgresql://[USER]:[PASSWORD]@[HOST]:[PORT]/[DATABASE]"
